+        ggml_tensor * cdst = ggml_view_3d(ctx, cache_s, D, 1, n_written, cache_s->nb[1], mem_size * cache_s->nb[1], 0);
+        ggml_tensor * ccpy = ggml_cpy(ctx, tail, cdst);
