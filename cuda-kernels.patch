+        ggml_cuda_mmq_load_tiles_iq2_xs<type, J, fallback, x_pitch>(xs, x_tile, shift0, i_max, dshift);
+    } else if constexpr (type == GGML_TYPE_IQ2_S) {
+        ggml_cuda_mmq_load_tiles_iq2_s<type, J, fallback, x_pitch>(xs, x_tile, shift0, i_max, dshift);
+    } else if constexpr (type == GGML_TYPE_IQ3_XXS) {
+        ggml_cuda_mmq_load_tiles_iq3_xxs<type, J, fallback, x_pitch>(xs, x_tile, shift0, i_max, dshift);
+    } else if constexpr (type == GGML_TYPE_IQ3_S) {
+        ggml_cuda_mmq_load_tiles_iq3_s<type, J, fallback, x_pitch>(xs, x_tile, shift0, i_max, dshift);
+    } else if constexpr (type == GGML_TYPE_IQ4_XS) {
+        ggml_cuda_mmq_load_tiles_iq4_xs<type, J, fallback, x_pitch>(xs, x_tile, shift0, i_max, dshift);
+    } else {
+        static_assert(type == GGML_TYPE_COUNT, "type does not support staging");
+    }
