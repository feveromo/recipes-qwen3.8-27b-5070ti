+        std::mt19937 rng_gen(1234);
+        for (ggml_tensor * tt = ggml_get_first_tensor(ctx); tt != NULL; tt = ggml_get_next_tensor(ctx, tt)) {
+            if (strcmp(tt->name, "ids") == 0) {
