+        r.q1    = mmvq_s8_ld_b2(b->qs, 2*s + 1);
+        r.qh    = mmvq_s8_ld8(b->qh + s);
+        r.signs = mmvq_s8_ld_b2(b->signs, s);
+        r.sc    = mmvq_s8_ld8(b->scales + s/2);
+        r.d     = mmvq_s8_ld16(&b->d);
