+            for (int offset = 1; offset < GDN_PF_P; offset *= 2) {
+#pragma unroll
+                for (int j = 0; j < CT; ++j) {
+                    rk[j] += __shfl_xor_sync(0xFFFFFFFF, rk[j], offset, WARP_SIZE);
+                }
+#pragma unroll
+                for (int j = 0; j < CT; ++j) {
+                    rq[j] += __shfl_xor_sync(0xFFFFFFFF, rq[j], offset, WARP_SIZE);
+                }
+                kq += __shfl_xor_sync(0xFFFFFFFF, kq, offset, WARP_SIZE);
+            }
