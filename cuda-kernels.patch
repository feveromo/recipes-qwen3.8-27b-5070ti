+                const float4 q4 = *((const float4 *) (qt + GDN_PF_P*m));
+                kr[m + 0] = k4.x;
+                kr[m + 1] = k4.y;
+                kr[m + 2] = k4.z;
+                kr[m + 3] = k4.w;
+                kq2[0] += k4.x*q4.x;
+                kq2[1] += k4.y*q4.y;
+                kq2[0] += k4.z*q4.z;
+                kq2[1] += k4.w*q4.w;
