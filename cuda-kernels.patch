+                for (int j = 0; j < CT; ++j) {
+                    sk[j][0] += s[j][m + 0]*k4.x;
+                    sk[j][1] += s[j][m + 1]*k4.y;
+                    sk[j][0] += s[j][m + 2]*k4.z;
+                    sk[j][1] += s[j][m + 3]*k4.w;
+                    sq[j][0] += s[j][m + 0]*q4.x;
+                    sq[j][1] += s[j][m + 1]*q4.y;
+                    sq[j][0] += s[j][m + 2]*q4.z;
+                    sq[j][1] += s[j][m + 3]*q4.w;
