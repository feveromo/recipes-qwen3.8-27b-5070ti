+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne01 = src0->ne[1];
+    const int64_t ne11 = dst->ne[1];
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || dst->ne[0] != ne01 || dst->ne[2] != 1 || dst->ne[3] != 1 ||
