+static bool ggml_cuda_q8_cache_eligible(const ggml_tensor * src1) {
+    return src1->type == GGML_TYPE_F32 && ggml_is_contiguous(src1) && src1->ne[2] == 1 && src1->ne[3] == 1 &&
