+    ggml_tensor * src_head = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
+    ggml_tensor * src_embd = layer.nextn.embed_tokens     ? layer.nextn.embed_tokens     : model.tok_embd;
