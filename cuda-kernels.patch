+        if (order) { ggml_build_forward_expand(gf, q); }
+        ggml_tensor * k = ggml_scale(ctx, ggml_rms_norm(ctx, kv, eps / S), 1.0f / sqrtf((float) S));
+        if (order) { ggml_build_forward_expand(gf, k); }
