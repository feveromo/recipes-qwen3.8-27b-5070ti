+    for (int k = 0; k < npt; ++k) {
+        const int col = k * block_size + tid;
+        float x = 0.0f;
+        if (col < ncols) {
+            x = a[col];
+            if constexpr (do_add) {
+                x = x + b[col];
+                sum_out[col] = x;
+            }
+        }
+        xv[k] = x;
+        ss += x * x;
+    }
