+        if (order) { ggml_build_forward_expand(gf, gate); }
+        ggml_tensor * beta  = ggml_sigmoid(ctx, ggml_reshape_4d(ctx, ggml_mul_mat(ctx, wb, x), 1, H_v, n_t, 1));
