+// A new sequence must start from an empty state even when it gets a cell that an earlier (multi-seq) ubatch range
+// covered while it was empty: such a cell keeps a source row, and with rollback by replay it also kept the pending
+// ring rows of the sequence that released it. The reference runs the same operations (same KV layout and ubatch
+// shapes, so the comparison is exact on any backend) but drops those rows by a rollback before releasing the cell.
+static bool test_new_seq_in_released_cell(const common_params & params, llama_model * model, const int n_vocab, uint8_t fill) {
+    const auto make = [&]() {
+        auto cparams = common_context_params_to_llama(params);
+        cparams.n_seq_max  = 3;
+        cparams.n_rs_seq   = 3;
+        cparams.n_ctx      = 256;
+        cparams.n_batch    = 64;
+        cparams.n_ubatch   = 32;
+        cparams.kv_unified = true; // non-sequential splits: seqs 0 and 2 share a ubatch around the empty cell of seq 1
+        return init_ctx(model, cparams, fill);
+    };
+    llama_context * ctx = make();
+    llama_context * ref = make();
+    if (ctx == nullptr || ref == nullptr) {
+        fprintf(stderr, "%s : failed to init contexts\n", __func__);
+        return false;
+    }
+    const auto tok = [&](uint32_t seq, llama_pos pos) {
+        return (llama_token) ((13*(uint32_t) pos + 7*seq + 3) % (uint32_t) n_vocab);
+    };
+    const auto decode = [&](llama_context * c, const std::vector<std::pair<llama_seq_id, std::pair<llama_pos, int>>> & parts, bool logits) {
+        llama_batch batch = llama_batch_init(64, 0, 1);
+        for (const auto & [s, pn] : parts) {
+            for (int i = 0; i < pn.second; ++i) {
+                common_batch_add(batch, tok(s, pn.first + i), pn.first + i, { s }, logits);
+            }
+        }
+        const bool ok = llama_decode(c, batch) == 0;
+        llama_batch_free(batch);
+        return ok;
+    };
+    bool ok = true;
+    for (llama_context * c : { ctx, ref }) {
+        llama_memory_t mem = llama_get_memory(c);
+        ok = ok && decode(c, { { 0, { 0, 8 } }, { 1, { 0, 8 } }, { 2, { 0, 8 } } }, false); // cells 0, 1, 2
+        ok = ok && decode(c, { { 1, { 8, 3 } } }, false);                                   // seq 1: rows kept for rollback
+        if (c == ref) {
+            llama_memory_seq_rm(mem, 1, 8, -1); // may be refused (no rollback support): only the release below matters
+        }
+        ok = ok && llama_memory_seq_rm(mem, 1, -1, -1);                                     // releases cell 1
+        ok = ok && decode(c, { { 0, { 8, 2 } }, { 2, { 8, 2 } } }, false);                  // range [0, 2] covers the empty cell
+        ok = ok && decode(c, { { 1, { 0, 5 } } }, true);                                    // new seq 1 in the used-empty cell
+    }
+    float diff = 0.0f;
+    for (int i = 0; ok && i < 5; ++i) {
+        const float * a = llama_get_logits_ith(ctx, i);
+        const float * b = llama_get_logits_ith(ref, i);
+        ok = a != nullptr && b != nullptr;
+        for (int t = 0; ok && t < n_vocab; ++t) {
+            diff = std::max(diff, logit_diff(a[t], b[t]));
+        }
+    }
+    // the recurrent state itself (the logits of a small random model barely depend on it)
+    bool same_state = false;
+    if (ok) {
+        std::vector<uint8_t> sa(llama_state_seq_get_size_ext(ctx, 1, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
+        std::vector<uint8_t> sb(llama_state_seq_get_size_ext(ref, 1, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
+        ok = !sa.empty() && !sb.empty() &&
+             llama_state_seq_get_data_ext(ctx, sa.data(), sa.size(), 1, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == sa.size() &&
+             llama_state_seq_get_data_ext(ref, sb.data(), sb.size(), 1, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY) == sb.size();
+        same_state = ok && sa == sb;
+    }
+    llama_free(ctx);
+    llama_free(ref);
+    if (!ok || diff > 0.0f || !same_state) {
+        fprintf(stderr, "%s : new sequence does not start from an empty state (ok=%d, max logit diff %g, same state %d)\n",
+                __func__, ok ? 1 : 0, (double) diff, same_state ? 1 : 0);
+        return false;
+    }
+    fprintf(stderr, "%s : new sequence in a released cell matched\n", __func__);
+    return true;
+}
+
 static int test_rollback(const common_params & params, llama_model * model, uint8_t fill) {
     const llama_vocab * vocab   = llama_model_get_vocab(model);
