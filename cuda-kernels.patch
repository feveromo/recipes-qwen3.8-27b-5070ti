+struct test_add_gumbel : public test_case {
+    const ggml_type type_ids;
+    const std::array<int64_t, 2> ne;
+    const float t;
+    const int32_t k_off;
+    const int32_t n_valid;
+    const int32_t top_k;
+    const float top_p;
+    const bool peaked; // a few large values (top-p keeps only a few) and copies of the first one
