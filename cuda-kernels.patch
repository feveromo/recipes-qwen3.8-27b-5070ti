+                size_t c = cand.size();
+                if (top_p < 1.0f) {
+                    std::vector<float> e(cand.size());
+                    float sum = 0.0f;
+                    for (size_t l = 0; l < cand.size(); ++l) {
+                        e[l] = (float) exp((double) a[cand[l]] - (double) a[cand[0]]);
+                        e[l] = e[l] < FLT_MIN ? 0.0f : e[l]; // as the GPU (flush to zero)
+                        sum += e[l];
+                    }
+                    const float lim = top_p*sum;
+                    float cum = 0.0f;
+                    for (size_t l = 0; l < cand.size(); ++l) {
+                        cum += e[l];
+                        if (cum >= lim) {
+                            c = l + 1;
+                            break;
+                        }
+                    }
+                }
