+    constexpr int warp_size     = ggml_cuda_get_physical_warp_size();
+    constexpr int row_bytes     = ggml_cuda_fattn_mma_q4_0_row_bytes(D);
+    constexpr int pairs_per_row = D / (2*QK4_0);
