+// rms_norm(e) * we, rms_norm(h) * wh -> concat (dim 0) [-> MMVQ] (Qwen3.5 MTP enorm/hnorm -> eh_proj); mode 1: a single
+// rms_norm * w without an MMVQ consumer
+struct test_rms_norm_concat_mmvq : public test_case {
