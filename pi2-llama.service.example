[Unit]
Description=Pi2 Qwen3.8 27B llama.cpp server
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/fever/Dev/llama.cpp-pi2
Environment=LD_LIBRARY_PATH=/usr/local/cuda-13.1/lib64
EnvironmentFile=-%t/pi2-llama.env
ExecStart=/home/fever/.pi2/agent/bin/pi2-llama-server
Restart=on-failure
RestartSec=2
TimeoutStartSec=420
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=default.target
